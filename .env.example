# Provider API keys — used by Bifrost (configured in Block 4.2 via the UI)
# These can also live entirely inside Bifrost; this file is a fallback for scripts.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Bifrost gateway URL (default for local workshop)
BIFROST_URL=http://localhost:8080

# Workshop Virtual Key — fill in after creating a VK in Block 4.4
# Used by the Nuxt app (Block 4.9) and by scripts/cache-demo.sh
WORKSHOP_VK=
